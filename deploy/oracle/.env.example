# Use generate-env.py; do not use these placeholders as credentials.
APP_IMAGE=supplyprint-oracle:REPLACE_WITH_GIT_SHA
PLATFORM=linux/arm64
DB_ADMIN_PASSWORD=replace-with-random-credential
DB_APP_PASSWORD=replace-with-different-random-credential
DB_MIGRATION_PASSWORD=replace-with-third-random-credential
JWT_SECRET=replace-with-random-48-byte-credential
TRUSTED_ORIGINS=https://your-frontend.example
API_HOST=api.your-domain.example
ACME_EMAIL=you@example.com
BLOCKCHAIN_ENABLED=false
API_LOCAL_PORT=18081
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_MIB=2048
