# Copy to .env for docker compose. Never commit your real .env.
DB_PASSWORD=replace-with-a-local-password
# Required: random 32+ character signing secret; no built-in default.
JWT_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
SECURE_COOKIES=false
# Explicit synthetic seeding only; not read by the application startup.
DEMO_PASSWORD=replace-with-12-or-more-characters
DEMO_PREFIX=lotline-demo
# Native Java local development defaults (Compose overrides DB_HOST to db).
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lotline
DB_USER=lotline
DB_POOL_SIZE=5
DB_SSLMODE=prefer
# Render supplies DATABASE_URL from its database relationship. A tested
# converter creates JDBC and extracts credentials without logging them.
# DATABASE_URL=postgresql://user:percent-encoded-password@host:5432/database
# Optional dedicated migration account (see docs/security.md).
# MIGRATION_DB_USER=
# MIGRATION_DB_PASSWORD=
