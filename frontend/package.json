{
  "name": "lotline-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.9.2"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src tests",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "format": "prettier --write src tests *.ts *.json *.js index.html",
    "format:check": "prettier --check src tests *.ts *.json *.js index.html"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/fraunces": "5.2.8",
    "@tanstack/react-query": "5.104.2",
    "gsap": "3.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "web-vitals": "6.2.3"
  }
}
