{
    "framework": "create-react-app",
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "http://localhost:8080/api/:path*"
        },
        {
            "source": "/actuator/:path*",
            "destination": "http://localhost:8080/actuator/:path*"
        }
    ],
    "headers": [
        {
            "source": "/static/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "s-maxage=31536000,immutable"
                }
            ]
        }
    ],
    "env": {
        "REACT_APP_API_BASE": "",
        "REACT_APP_API_BASE_URL": "/api/products",
        "REACT_APP_VERIFICATION_API_URL": "/api/verify",
        "REACT_APP_EVENT_API_URL": "/api/events"
    }
}